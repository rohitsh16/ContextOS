{
  "_managedBy": "contextos",
  "_version": "0.7.0",
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "'ctx-hook' -agent 'cursor' -event 'beforeSubmitPrompt'"
      }
    ],
    "postToolUse": [
      {
        "command": "'ctx-hook' -agent 'cursor' -event 'postToolUse'"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "'ctx-hook' -agent 'cursor' -event 'postToolUseFailure'"
      }
    ],
    "sessionStart": [
      {
        "command": "'ctx-hook' -agent 'cursor' -event 'sessionStart'"
      }
    ],
    "stop": [
      {
        "command": "'ctx-hook' -agent 'cursor' -event 'stop'"
      }
    ],
    "workspaceOpen": [
      {
        "command": "'ctx-hook' -agent 'cursor' -event 'workspaceOpen'"
      }
    ]
  }
}
